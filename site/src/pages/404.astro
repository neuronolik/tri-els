---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base description="There's nothing at this address." title="Not found · Slab">
  <div class="page">
    <p class="eyebrow">404</p>
    <h1>Nothing poured here.</h1>
    <p>There's nothing at this address. It may have moved, or never existed.</p>
    <div class="ctas">
      <a class="button button--primary" href={`${base}get-started/`}>Get started</a>
      <a class="button" href={`${base}components/`}>Browse the components</a>
    </div>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    margin-inline: auto;
    max-inline-size: 78rem;
    padding: clamp(3rem, 10vw, 7rem) var(--gutter);
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0;
  }

  p:not(.eyebrow) {
    font-size: 1.25rem;
    margin: 0;
    max-inline-size: 40ch;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block-start: 0.75rem;
  }
</style>
